# Backend environment variables. Copy to backend/.env for local dev.
# In production, set these on the host (don't commit secrets).

# Required
OPENAI_API_KEY=your-api-key-here

# Required in production (validated on startup):
#   - At least 32 chars, never the placeholder.
#   - Use `python -c "import secrets; print(secrets.token_urlsafe(48))"` to generate.
JWT_SECRET=change-me-to-a-random-string

# Required in production. Comma-separated list of allowed frontend origins.
# CORS_ORIGINS=https://app.example.com

# Optional
FLASK_ENV=development
DATABASE_PATH=instance/database.db
LOG_LEVEL=INFO
