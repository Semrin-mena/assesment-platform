# Backend environment variables. Copy to backend/.env for local dev.
# In production, set these on the host (don't commit secrets).

# Required
OPENAI_API_KEY=your-api-key-here

# Required (PostgreSQL connection string).
# Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME
# Local dev:  postgresql://postgres:postgres@localhost:5432/assessment
# Production: use the role/db you provisioned on Hetzner; keep this off git.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/assessment

# Required in production (validated on startup):
#   - At least 32 chars, never the placeholder.
#   - Use `python -c "import secrets; print(secrets.token_urlsafe(48))"` to generate.
JWT_SECRET=change-me-to-a-random-string

# Required in production. Comma-separated list of allowed frontend origins.
# CORS_ORIGINS=https://app.example.com

# Optional
FLASK_ENV=development
LOG_LEVEL=INFO
DB_POOL_MIN=1
DB_POOL_MAX=10
